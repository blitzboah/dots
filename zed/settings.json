{
  // general

  "buffer_font_family": ".ZedMono",
  "cli_default_open_behavior": "new_window",
  "disable_ai": false,
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "terminal": {
    "working_directory": {
      "always": {
        "directory": "",
      },
    },
    "shell": {
      "program": "/run/current-system/sw/bin/nu",
    },
  },

  // git

  "git": {
    "inline_blame": {
      "enabled": true,
    },
  },

  // lalamo
  "agent": {
    "dock": "right",
    "default_profile": "ask",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "gpt-5.3-codex",
    },
    "model_parameters": [],
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "ui_font_size": 15,
  "buffer_font_size": 13,
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },

  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
    "OpenCode": {
      "type": "custom",
      "command": "opencode",
      "args": ["acp"],
    },
  },

  "show_edit_predictions": true,

  "edit_predictions": {
    "provider": "copilot",
  },

  // tab

  "tabs": {
    "git_status": true,
  },

  "experimental.theme_overrides": {
    "tab.active_background": "#313244",
    "tab.inactive_background": "#181825",
    "tab_bar.background": "#11111b",
  },

  // lang

  "languages": {
    "Go": {
      "tab_size": 4,
    },
  },
}
