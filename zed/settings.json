{
  "terminal": {
    "working_directory": {
      "always": {
        "directory": "",
      },
    },
    "shell": {
      "program": "/run/current-system/sw/bin/nu",
    },
  },
  "agent": {
    "default_profile": "write",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini",
    },
    "model_parameters": [],
  },
  "vim_mode": true,
  "ui_font_size": 15,
  "buffer_font_size": 14,
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
}
