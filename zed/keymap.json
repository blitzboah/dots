[
  {
    "context": "Editor && vim_mode == normal || vim_mode == visual",
    "bindings": {
      "g h": "vim::FirstNonWhitespace",
      "g l": "vim::EndOfLine",
      "g e": "vim::EndOfDocument",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "Ctrl [": "vim::NormalBefore",
    },
  },
]
